<Project Sdk="Microsoft.NET.Sdk.Web">
	
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<OutputType>Library</OutputType>
	<IsPackable>true</IsPackable>
	<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
	<WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
	<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	<NoWarn>NU5128</NoWarn>

	<!-- NuGet metadata -->
	<PackageId>Entra.EventHandlers.AspNetCore</PackageId>
	<Version>1.2.4</Version>
	<Authors>Jakub Szubarga</Authors>
	<Company>Szubarga.NET Jakub Szubarga</Company>

	<Description>
	ASP.NET Core hosting adapter for Microsoft Entra External ID and Workforce Authentication Event
	Handlers. Provides minimal-boilerplate endpoint mapping, request/response adapters, unified
	execution pipeline, DI integration, structured logging, and production-ready hosting for custom
	authentication extensions.
	</Description>

	<PackageTags>
	entra;entra-id;microsoft-entra;microsoft-entra-id;external-id;workforce;verified-id;ciam;
	authentication-events;event-handlers;identity;authentication;dotnet;aspnetcore;minimal-apis;
	middleware;csharp
	</PackageTags>

	<RepositoryUrl>https://github.com/szubajak/entra-event-handlers</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://github.com/szubajak/entra-event-handlers</PackageProjectUrl>

	<PackageLicenseFile>LICENSE</PackageLicenseFile>
	<PackageReadmeFile>README.NuGet.md</PackageReadmeFile>
	<PackageIcon>icon.png</PackageIcon>

	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>

	<PackageReleaseNotes>
	Includes ASP.NET Core hosting adapter for Microsoft Entra External ID and Workforce Authentication
	Event Handlers. Provides request/response adapters, endpoint base classes, DI integration, unified
	execution pipeline, router endpoint, and single-event endpoint mapping extensions.
	</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
	<IsPackable>false</IsPackable>
  </PropertyGroup>
	
  <ItemGroup>
	<None Include="LICENSE" Pack="true" PackagePath="" />
	<None Include="LICENSE-COMMERCIAL.md" Pack="true" PackagePath="" />
	<None Include="README.NuGet.md" Pack="true" PackagePath="" />
	<None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'=='Debug'">
	<ProjectReference Include="..\..\hosting\Entra.EventHandlers.Hosting\Entra.EventHandlers.Hosting.csproj" />
	<PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'=='Release'">
	  <ProjectReference Include="..\..\hosting\Entra.EventHandlers.Hosting\Entra.EventHandlers.Hosting.csproj">
		  <IncludeAssets>none</IncludeAssets>
	  </ProjectReference>
	  
	  <PackageReference Include="Entra.EventHandlers.Abstractions" Version="1.4.1" PrivateAssets="all" />

	  <None Include="..\..\hosting\Entra.EventHandlers.Hosting\bin\Release\net10.0\Entra.EventHandlers.Hosting.dll"
		  Pack="true"
		  PackagePath="lib/net10.0/" />
  </ItemGroup>

</Project>