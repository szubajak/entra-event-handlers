<Project>
	
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
	<UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
	<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	<EnableMSTestRunner>true</EnableMSTestRunner>
	<VSTestEnabled>false</VSTestEnabled>
	<OutputType>Exe</OutputType>
  </PropertyGroup>
	
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
	<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
	<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
	<PackageReference Include="NSubstitute" Version="6.2.0" />
	<PackageReference Include="AutoFixture" Version="4.18.1" />
	<PackageReference Include="FluentAssertions" Version="[7.2.0]" />
	<PackageReference Include="xunit.v3" Version="4.0.1" />
	<PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />

	<Using Include="Xunit" />
  </ItemGroup>
	
</Project>
